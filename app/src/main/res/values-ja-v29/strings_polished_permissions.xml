    <string name="permission_name_core">vFlow Coreサービス</string>
    <string name="permission_desc_core">疑似タップやシステム操作など高度な処理を行うvFlow Coreバックグラウンドサービスです。ShizukuまたはRootで起動できます。</string>
    <string name="permission_desc_core_root">vFlow CoreをRoot権限で実行する必要がある機能に使用します。</string>
    <string name="permission_name_accessibility">アクセシビリティサービス</string>
    <string name="permission_desc_accessibility">タップ、要素検索、入力など主要な自動化機能に必要です。</string>
    <string name="permission_name_notifications">通知権限</string>
    <string name="permission_desc_notifications">通知やタスク実行結果を表示するために使用します。</string>
    <string name="permission_name_microphone">マイク権限</string>
    <string name="permission_desc_microphone">音声入力や音声テキスト変換に使用します。</string>
    <string name="permission_name_overlay">他のアプリの上に表示</string>
    <string name="permission_desc_overlay">バックグラウンド動作中に入力画面などを重ねて表示するために使用します。</string>
    <string name="permission_name_notification_listener">通知へのアクセス</string>
    <string name="permission_desc_notification_listener">ステータスバーの通知を読み取り・操作し、通知トリガーや通知管理に使用します。</string>
    <string name="permission_name_notification_policy">サイレントモード設定へのアクセス</string>
    <string name="permission_desc_notification_policy">Androidの「サイレントモード」をオン・オフ・切り替えできるようにします。</string>
    <string name="permission_name_storage">ストレージアクセス</string>
    <string name="permission_desc_storage">/sdcard/vFlow 内のスクリプトやリソースファイルを読み書きするために使用します。</string>
    <string name="permission_name_sms">SMS権限</string>
    <string name="permission_desc_sms">SMSを受信・読み取りしてワークフローをトリガーするために使用します。</string>
    <string name="permission_name_bluetooth">Bluetooth権限</string>
    <string name="permission_desc_bluetooth">端末のBluetooth状態を操作するために使用します。</string>
    <string name="permission_name_write_settings">システム設定の変更</string>
    <string name="permission_desc_write_settings">画面の明るさなど、システム設定を変更するために使用します。</string>
    <string name="permission_name_write_secure_settings">Secure Settingsの変更</string>
    <string name="permission_desc_write_secure_settings">アクセシビリティサービスの自動有効化などのため、保護されたシステム設定を直接変更できるようにします。</string>
    <string name="permission_name_location">正確な位置情報</string>
    <string name="permission_desc_location">一部のAndroidバージョンで保存済みWi-Fi一覧へアクセスするために必要です。</string>
    <string name="permission_name_background_location">バックグラウンド位置情報</string>
    <string name="permission_desc_background_location">位置トリガーなどでバックグラウンドの位置変化を継続監視するために使用します。</string>
    <string name="permission_desc_shizuku">Shellコマンドなど、高い権限が必要な操作をShizuku経由で実行できるようにします。</string>
    <string name="permission_name_battery">バックグラウンド実行</string>
    <string name="permission_desc_battery">バッテリー最適化の対象外にして、キー監視などのバックグラウンドトリガーを安定して動作させます。</string>
    <string name="permission_name_alarm">アラームとリマインダー</string>
    <string name="permission_desc_alarm">時刻トリガーを正確な時刻に起動・実行するために使用します。</string>
    <string name="permission_name_root">Root権限</string>
    <string name="permission_desc_root">スーパーユーザー権限で低レベルのシステムコマンドを実行できるようにします。</string>
    <string name="permission_name_usage_stats">使用状況へのアクセス</string>
    <string name="permission_desc_usage_stats">アプリの使用時間や最終使用時刻などを読み取り、Agentの精度向上に使用します。</string>
    <string name="permission_name_read_phone_state">電話の状態</string>
    <string name="permission_desc_read_phone_state">通話トリガーのため、電話状態の変化を監視します。</string>
    <string name="permission_name_call_phone">電話の発信</string>
    <string name="permission_desc_call_phone">電話番号へ直接発信できるようにします。</string>

